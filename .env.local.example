# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# From sanity.io/manage → your project → Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version — a fixed date pins query behavior; bump deliberately.
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# From sanity.io/manage → your project → API → Tokens → Editor permission.
# Server-only: never referenced from a Client Component. Needed once
# draft/preview mode and the revalidation webhook are wired up.
SANITY_API_TOKEN=

# Shared secret for the Sanity → /api/revalidate webhook (sanity.io/manage →
# API → Webhooks). Same value in both places. Server-only. Generate with
# `openssl rand -hex 24`.
SANITY_REVALIDATE_SECRET=

# From supabase.com/dashboard/project/_/settings/api
# The anon/publishable key IS meant to be public — safety comes from RLS
# policies on each table, not from hiding this value.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's own canonical origin — used to build absolute URLs (LinkedIn
# share links, SEO canonical/OG tags) that must never resolve to
# localhost or a preview URL in production. Set this to the real domain
# once deployed (e.g. https://promptatwork.com); safe to leave unset for
# local development, where it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Only needed to run scripts/sync-youtube.ts. From Google Cloud Console
# (enable "YouTube Data API v3" and create an API key) and the channel's
# "About" page (starts with "UC"). Server-only — never referenced from a
# Client Component.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Search engine ownership verification (optional). Paste only the
# content="..." value from the Google Search Console / Bing Webmaster
# Tools "HTML tag" method. Public by design.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
